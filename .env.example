# Upstash Redis credentials (Required for Vercel production & local dev with Upstash)
# Get these from your Upstash console (https://console.upstash.com) or Vercel Upstash integration
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Optional: Baseline starting count before the first visitor (Default: 52, so the first visitor gets #53)
INITIAL_VISITOR_COUNT="52"
